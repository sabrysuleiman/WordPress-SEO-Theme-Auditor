  "homepage": "https://github.com/sabrysuleiman/wordpress-seo-theme-auditor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabrysuleiman/wordpress-seo-theme-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/sabrysuleiman/wordpress-seo-theme-auditor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
